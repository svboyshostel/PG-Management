# Required: client-owned Neon pooled PostgreSQL connection string.
DATABASE_URL=

# Optional until private document uploads are needed. Server-only.
# Uses a Supabase Secret API key (sb_secret_...), sent via the apikey header.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# No DIRECT_DATABASE_URL: migrations use the Neon HTTP driver.
# Auth uses database sessions and Web Crypto; no signing secret/email service.
# App links use the current origin; no application URL variable is required.
# Optional: demo preview is off in production by default (set ALLOW_DEMO_PREVIEW=true only when desired).
# ALLOW_DEMO_PREVIEW=false
